# Copy to .env and edit before giving to your client or going live.

# Required in production — use a long random string (32+ chars)
SECRET_KEY=replace-with-a-long-random-secret-key

# Port the app listens on
PORT=5000

# Where the SQLite database is stored (folder path)
DATA_DIR=.

# Set to 1 only for local development
FLASK_DEBUG=0

# Set to 1 when behind HTTPS reverse proxy (nginx, Render, Railway, etc.)
BEHIND_PROXY=0

# Username that gets admin panel access (must sign up with this name first)
INITIAL_ADMIN_NAME=Apex

# Optional — email the parent when a kid taps Stop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com
# SMTP_SSL=0

# Local Ollama teacher (offline). Default model is llama3.2:3b
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# Subscription (1000 PKR/month).
#
# TIER 1 — manual transfer (works with no JazzCash merchant account).
# Parents send money to these numbers, put their claim code in the transfer
# remarks, and report the transaction ID on /subscribe. An admin then matches
# the claim code + amount in their own app and approves. See JAZZCASH_SETUP.md
# for exactly what this can and cannot protect you against.
# JAZZCASH_NUMBER=03xx-xxxxxxx
# EASYPAISA_NUMBER=03xx-xxxxxxx
#
# TIER 2 — automatic confirmation (needs a JazzCash merchant account).
# With these set, parents pay on JazzCash's own page and the subscription
# activates on a signed gateway callback — no admin step, and nothing for a
# scammer to forge. Get the four values below from your JazzCash integration
# guide; the two URLs are per-merchant and have NO defaults on purpose, because
# guessing them fails silently in production.
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=          (the API password, NOT your Jazz app login)
# JAZZCASH_INTEGRITY_SALT=    (the "Hash Key" / shared secret)
# JAZZCASH_CHECKOUT_URL=      (hosted checkout endpoint, e.g. .../Purchase/SecuredHashPost)
# JAZZCASH_STATUS_INQUIRY_URL= (transaction status inquiry endpoint)
# JAZZCASH_RETURN_URL=        (where JazzCash sends the payer back)
#
# Then register this webhook with JazzCash, subscribed to payment success:
#   https://yourdomain/webhooks/jazzcash
# It verifies the HMAC signature, so it is exempt from CSRF by design.
# Card payments via Stripe Checkout — works for anyone worldwide, not just
# JazzCash/EasyPaisa. This is real recurring billing (mode="subscription"),
# so the Price MUST be a RECURRING price, not one-time. Create a Product +
# recurring Price in your Stripe dashboard first, then set:
#   STRIPE_SECRET_KEY   — sk_live_... or sk_test_... from the Stripe dashboard
#   STRIPE_PRICE_ID     — price_... for the recurring subscription price you created
#   STRIPE_WEBHOOK_SECRET — whsec_... from the webhook endpoint you register
#     pointing at https://yourdomain/webhooks/stripe. Subscribe it to at least:
#     checkout.session.completed, customer.subscription.created,
#     customer.subscription.updated, invoice.payment_failed,
#     invoice.payment_succeeded, charge.refunded, charge.dispute.created
# The "Pay by Card" button only appears once STRIPE_SECRET_KEY and
# STRIPE_PRICE_ID are both set; without them it still shows "coming soon".
# See STRIPE_SETUP.md for the Dashboard-only steps (Radar, trial-abuse
# prevention) that can't be set from code or env vars.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# Shown on /subscribe as a copyable "talk to the owner" contact, with a Copy
# button and a mailto: link. Not sent anywhere automatically.
# OWNER_CONTACT_EMAIL=you@example.com

# Random secret so a PythonAnywhere Scheduled Task can trigger the weekly
# parent-report email without a browser login session. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# WEEKLY_REPORT_CRON_KEY=

# Google Play TWA (after you sign the Android app)
# ANDROID_PACKAGE=com.wordstars.app
# ANDROID_CERT_SHA256=AB:CD:EF:...

# "Come back and play" Web Push reminders — sent to a device only after it
# explicitly opts in on /settings (browser notification permission prompt).
# Generate a key pair with:  python tools/generate_vapid_keys.py
# Then trigger a send once a day. PythonAnywhere's one free Scheduled Task is
# already used for the weekly report above, so hit this endpoint from an
# external free cron (cron-job.org, a GitHub Actions schedule, UptimeRobot)
# using the SAME WEEKLY_REPORT_CRON_KEY secret instead of a second local task:
#   curl -X POST https://yourdomain/admin/api/push/send-reminders \
#     -H "X-Cron-Key: your-WEEKLY_REPORT_CRON_KEY-value"
# VAPID_PRIVATE_KEY_PEM=   (PEM string with real newlines replaced by \n)
# VAPID_PUBLIC_KEY=        (base64url — also sent to the browser as-is)
# VAPID_CLAIM_EMAIL=you@example.com
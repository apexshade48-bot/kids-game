# Copy to .env and edit before giving to your client or going live.

# Required in production — use a long random string (32+ chars)
SECRET_KEY=replace-with-a-long-random-secret-key

# Port the app listens on
PORT=5000

# Where the SQLite database is stored (folder path)
DATA_DIR=.

# Set to 1 only for local development
FLASK_DEBUG=0

# Set to 1 when behind HTTPS reverse proxy (nginx, Render, Railway, etc.)
BEHIND_PROXY=0

# Username that gets admin panel access (must sign up with this name first)
INITIAL_ADMIN_NAME=Apex

# Optional — email the parent when a kid taps Stop
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com
# SMTP_SSL=0

# Local Ollama teacher (offline). Default model is llama3.2:3b
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# Subscription (1000 PKR/month) — manual JazzCash/EasyPaisa confirmation flow.
# Parents send money to these numbers, report the transaction ID on /subscribe,
# and an admin approves it in the admin panel to unlock the account.
# JAZZCASH_NUMBER=03xx-xxxxxxx
# EASYPAISA_NUMBER=03xx-xxxxxxx
# Card payments via Stripe Checkout — works for anyone worldwide, not just
# JazzCash/EasyPaisa. Create a Product + (recurring or one-time) Price in your
# Stripe dashboard first, then set:
#   STRIPE_SECRET_KEY   — sk_live_... or sk_test_... from the Stripe dashboard
#   STRIPE_PRICE_ID     — price_... for the subscription price you created
#   STRIPE_WEBHOOK_SECRET — whsec_... from the webhook endpoint you register
#     pointing at https://yourdomain/webhooks/stripe for the
#     "checkout.session.completed" event
# The "Pay by Card" button only appears once STRIPE_SECRET_KEY and
# STRIPE_PRICE_ID are both set; without them it still shows "coming soon".
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# Shown on /subscribe as a copyable "talk to the owner" contact, with a Copy
# button and a mailto: link. Not sent anywhere automatically.
# OWNER_CONTACT_EMAIL=you@example.com

# Random secret so a PythonAnywhere Scheduled Task can trigger the weekly
# parent-report email without a browser login session. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# WEEKLY_REPORT_CRON_KEY=

# Google Play TWA (after you sign the Android app)
# ANDROID_PACKAGE=com.wordstars.app
# ANDROID_CERT_SHA256=AB:CD:EF:...